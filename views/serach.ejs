<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search | KASET-NEWS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        body { 
            font-family: 'Inter', sans-serif; 
            background-color: #020608; 
            background-image: url('/images/grid-bg.png'); 
            background-repeat: repeat;
            color: #9ca3af; 
        }
        .cyber-title { font-weight: 900; letter-spacing: -0.02em; line-height: 0.9; text-transform: uppercase; }
    </style>
</head>
<body class="min-h-screen">

    <%- include('partials/header') %>

    <header class="max-w-7xl mx-auto px-8 pt-16 pb-12">
        <div class="text-cyan-400 text-[10px] font-black tracking-[0.2em] mb-6 uppercase">
            <span class="opacity-50">//</span> Kaset-News <span class="mx-2 text-gray-700">/</span> Search
        </div>
        <h1 class="cyber-title text-7xl text-white mb-4">Search Articles</h1>
        <p class="text-gray-500 text-lg uppercase font-bold tracking-tight">Search across national, ASEAN, and international cyber news.</p>
    </header>

    <main class="max-w-7xl mx-auto px-8 pb-20">
        <form action="/search" method="GET" class="flex mb-8">
            <input 
                type="text" 
                name="q" 
                placeholder="Search articles, CVEs, threat actors..." 
                value="<%= query %>"
                class="w-full bg-gray-900/40 border border-gray-800 p-6 text-gray-300 focus:outline-none focus:border-cyan-400 font-bold text-sm tracking-widest"
            />
            <button type="submit" class="bg-cyan-400 text-black px-12 font-black uppercase tracking-widest text-sm">Search</button>
        </form>

        <div class="flex flex-wrap gap-2 mb-12">
            <% ['all', 'national', 'asean', 'international', 'malware', 'breach'].forEach(filter => { %>
                <a 
                    href="/search?q=<%= query %>&filter=<%= filter %>" 
                    class="px-5 py-2 border <%= filter === currentFilter ? 'border-cyan-400 text-cyan-400' : 'border-gray-800 text-gray-600' %> text-[10px] font-black uppercase tracking-widest"
                >
                    <%= filter === 'all' ? 'All' : filter.charAt(0).toUpperCase() + filter.slice(1) %>
                </a>
            <% }) %>
        </div>

        <div class="flex flex-col lg:flex-row gap-12">
            <div class="lg:w-2/3 space-y-12">
                <div class="text-[10px] font-black text-gray-700 uppercase tracking-[0.3em] border-b border-gray-900 pb-4">
                    Showing <%= results.length %> Results for "<%= query %>"
                </div>

                <% if (results.length === 0) { %>
                    <div class="text-center py-12 text-gray-600">
                        No results found. Try different keywords.
                    </div>
                <% } %>

                <% results.forEach(article => { %>
                <article class="flex gap-8 group" onclick="location.href='/article/<%= article.id %>'">
                    <div class="w-48 h-32 bg-gray-900/40 border border-gray-800 flex items-center justify-center shrink-0 cursor-pointer">
                        <span class="text-[10px] text-gray-800 font-bold">IMG</span>
                    </div>
                    <div class="space-y-2">
                        <div class="flex items-center space-x-3 text-[9px] font-black uppercase tracking-widest">
                            <span class="<%= article.tagClass %>"><%= article.category %></span>
                            <span class="text-gray-600"><%= article.date %></span>
                        </div>
                        <h2 class="text-white text-xl font-bold group-hover:text-cyan-400 transition-colors cursor-pointer"><%= article.title %></h2>
                        <p class="text-sm text-gray-500 leading-relaxed"><%= article.excerpt %></p>
                        <div class="text-[9px] font-bold text-gray-600 uppercase"><%= article.author %> • <%= article.readTime %> Min Read</div>
                    </div>
                </article>
                <% }) %>

                <% if (results.length > 0 && hasMore) { %>
                <div class="text-center">
                    <a href="/search?q=<%= query %>&filter=<%= currentFilter %>&page=<%= nextPage %>" class="inline-block px-8 py-3 border border-gray-800 text-gray-400 hover:border-cyan-400 hover:text-cyan-400 text-xs font-bold uppercase tracking-widest">
                        LOAD MORE RESULTS →
                    </a>
                </div>
                <% } %>
            </div>

            <aside class="lg:w-1/3">
                <div class="bg-gray-900/30 border border-gray-800 p-8">
                    <h3 class="text-cyan-400 text-[10px] font-black uppercase tracking-[0.2em] mb-8">Popular Searches</h3>
                    <div class="flex flex-wrap gap-2">
                        <% popularSearches.forEach(tag => { %>
                        <a href="/search?q=<%= tag %>" class="text-[9px] font-bold text-gray-600 border border-gray-800 px-3 py-1.5 hover:text-white hover:border-cyan-400 uppercase tracking-widest">#<%= tag %></a>
                        <% }) %>
                    </div>
                </div>
            </aside>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>