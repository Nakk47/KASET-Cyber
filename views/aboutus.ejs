<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us | KASET-NEWS Cyber Operations</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,800;1,800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style type="text/tailwindcss">
      @theme {
        --font-heading: "Plus Jakarta Sans", sans-serif;
        --font-body: "Inter", sans-serif;
      }
      body { @apply bg-[#05070a] text-slate-300 font-body antialiased; }
    </style>
</head>
<body>

    <%- include('partials/header') %>

    <main class="max-w-[1400px] mx-auto px-8 py-20">
        
        <header class="mb-24 border-l-4 border-cyan-500 pl-10 max-w-4xl">
            <p class="text-[10px] font-bold uppercase tracking-[0.5em] text-cyan-400 mb-4">Origin & Mission</p>
            <h1 class="text-6xl lg:text-8xl font-extrabold text-white leading-tight font-heading uppercase italic tracking-tighter">
                <%= pageTitle %>
            </h1>
            <p class="mt-8 text-xl text-slate-400 leading-relaxed font-medium">
                <%= pageDescription %>
            </p>
        </header>

        <div class="grid grid-cols-12 gap-12 mb-32">
            <div class="col-span-12 lg:col-span-4 bg-white/[0.02] border border-white/5 p-10">
                <h3 class="text-[10px] font-black uppercase tracking-[0.3em] text-cyan-400 mb-12 flex items-center gap-2">
                    <span class="w-2 h-2 bg-cyan-400 rounded-full"></span> Platform Stats • 2026
                </h3>
                
                <div class="space-y-10">
                    <% stats.forEach(stat => { %>
                    <div class="flex justify-between items-end border-b border-white/5 pb-4">
                        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-widest"><%= stat.label %></span>
                        <span class="text-4xl font-black italic text-cyan-400 font-heading tracking-tighter"><%= stat.value %></span>
                    </div>
                    <% }) %>
                </div>
            </div>

            <div class="col-span-12 lg:col-span-8">
                <div class="flex items-center gap-4 mb-8">
                    <h3 class="text-[10px] font-black uppercase tracking-[0.3em] text-white whitespace-nowrap">What we cover</h3>
                    <div class="h-px bg-white/10 w-full"></div>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <% coverage.forEach(item => { %>
                    <div class="bg-white/[0.02] border <%= item.highlight ? 'border-cyan-500/30 shadow-[inset_0_0_20px_rgba(6,182,212,0.05)]' : 'border-white/5' %> p-8 hover:bg-white/[0.04] transition-colors">
                        <div class="mb-4 <%= item.iconColor %>"><%= item.icon %></div>
                        <h4 class="text-xl font-bold text-white mb-4"><%= item.title %></h4>
                        <p class="text-sm text-slate-400 leading-relaxed"><%= item.description %></p>
                    </div>
                    <% }) %>
                </div>
            </div>
        </div>

        <section class="mb-32">
            <div class="flex items-center gap-4 mb-12">
                <h3 class="text-[10px] font-black uppercase tracking-[0.3em] text-white whitespace-nowrap">The Team</h3>
                <div class="h-px bg-white/10 w-full"></div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <% teamMembers.forEach(member => { %>
                <div class="space-y-4">
                    <div class="aspect-square bg-slate-900 border border-white/5 flex items-center justify-center grayscale hover:grayscale-0 transition-all">
                        <span class="text-[10px] font-mono tracking-widest text-slate-700 uppercase">// Photo</span>
                    </div>
                    <div>
                        <h5 class="text-xl font-bold text-white uppercase tracking-tight"><%= member.name %></h5>
                        <p class="text-[10px] font-black text-cyan-400 uppercase tracking-widest mt-1 mb-3"><%= member.role %></p>
                        <p class="text-xs text-slate-500 leading-relaxed"><%= member.bio %></p>
                    </div>
                </div>
                <% }) %>
            </div>
        </section>

    </main>

    <%- include('partials/footer') %>

</body>
</html>